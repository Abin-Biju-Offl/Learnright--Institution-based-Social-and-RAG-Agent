# Copy this file to ".env" and change what you need. Everything is optional;
# the defaults (and what each setting means) are in app/config.py.
# Restart the server after changing anything.

# Adapters: which service does each job (see app/adapters.py)
#   simple mode (no database server):        EMBEDDER=ollama  LLM=ollama       VECTOR_STORE=simple
#   OPEA mode (optional, Docker):            EMBEDDER=tei     LLM=openai_like  VECTOR_STORE=qdrant
#   Claude Agent SDK / Anthropic:            EMBEDDER=ollama  LLM=claude       VECTOR_STORE=qdrant
#   Codex SDK / OpenAI:                      EMBEDDER=ollama  LLM=codex        VECTOR_STORE=qdrant
#   AntiGravity SDK / Gemini:                EMBEDDER=ollama  LLM=antigravity  VECTOR_STORE=qdrant
#   Groq API:                                EMBEDDER=ollama  LLM=groq         VECTOR_STORE=qdrant
#   Grok API:                                EMBEDDER=ollama  LLM=grok         VECTOR_STORE=qdrant
EMBEDDER=ollama
LLM=ollama
VECTOR_STORE=qdrant

# Models:
#   For Ollama:       qwen3.5:4b (download first: ollama pull qwen3.5:4b)
#   For Claude:       claude-3-5-sonnet-latest (or claude-3-7-sonnet-latest)
#   For Codex/OpenAI: gpt-4o-mini (or gpt-4o)
#   For AntiGravity:  gemini-2.0-flash (or gemini-1.5-flash)
#   For Groq:         llama-3.1-8b-instant (or llama-3.3-70b-versatile)
#   For Grok:         grok-2-latest
LLM_MODEL=qwen3.5:4b
EMBED_MODEL=qwen3-embedding:0.6b

# Cloud & SDK API Keys (set the key for whichever provider you use)
# Anthropic / Claude Agent SDK:
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=

# Codex SDK / OpenAI:
OPENAI_API_KEY=
# CODEX_API_KEY=

# AntiGravity SDK / Gemini:
GEMINI_API_KEY=
# ANTIGRAVITY_API_KEY=

# Groq API key (or GROK_API_KEY):
GROQ_API_KEY=
GROK_API_KEY=

# Where each service runs (only the ones your adapters use matter)
OLLAMA_URL=http://localhost:11434
EMBED_URL=http://localhost:6006
LLM_URL=http://localhost:9000/v1
# Empty = Qdrant stores its files in storage/qdrant, no server needed
QDRANT_URL=

# Retrieval tuning (run "python -m app.evaluate" after changing these)
TOP_K=4
MIN_SCORE=0.53

# Answer check: remove claims where more than this share of words is not in the textbook
MAX_NEW_SHARE=0.4

# If you change EMBEDDER, EMBED_MODEL, VECTOR_STORE or these two, rebuild the index:
#   python -m app.ingest
# (the server refuses to start until you do, so search never mixes two models)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
