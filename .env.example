# Copy this file to ".env" and change what you need. Everything is optional;
# the defaults (and what each setting means) are in app/config.py.
# Restart the server after changing anything.

# Adapters: which service does each job (see app/adapters.py)
#   simple mode (no database server):        EMBEDDER=ollama  LLM=ollama       VECTOR_STORE=simple
#   OPEA mode (optional, Docker):            EMBEDDER=tei     LLM=openai_like  VECTOR_STORE=qdrant
EMBEDDER=ollama
LLM=ollama
VECTOR_STORE=qdrant

# Models (for Ollama, download them first: ollama pull <name>)
LLM_MODEL=qwen3.5:4b
EMBED_MODEL=qwen3-embedding:0.6b

# Where each service runs (only the ones your adapters use matter)
OLLAMA_URL=http://localhost:11434
EMBED_URL=http://localhost:6006
LLM_URL=http://localhost:9000/v1
# Empty = Qdrant stores its files in storage/qdrant, no server needed
QDRANT_URL=

# Retrieval tuning (run "python -m app.evaluate" after changing these)
TOP_K=4
MIN_SCORE=0.53

# Answer check: remove claims where more than this share of words is not in the textbook
MAX_NEW_SHARE=0.4

# If you change EMBEDDER, EMBED_MODEL, VECTOR_STORE or these two, rebuild the index:
#   python -m app.ingest
# (the server refuses to start until you do, so search never mixes two models)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
